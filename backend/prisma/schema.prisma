generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  role       String       @default("ORDER_ENTRY")
  employeeId String?      @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditLogs  AuditLog[]
  stages     OrderStage[]
  createdOrders Order[]   @relation("OrderCreatedBy")
}

model Order {
  id              String       @id @default(uuid())
  orderNumber     String?      @unique
  shopifyOrderId  String?      @unique
  customerName    String
  customerPhone   String?
  address         String?
  createdById     String?
  type            String       @default("STANDARD")
  urgent          Boolean      @default(false)
  quantity        Int          @default(1)
  logoDesign      String?
  logoName        String?
  customization   String?
  productDetails  String?
  sizeData        String?
  currentStage    String       @default("ORDER_ENTRY")
  status          String       @default("PENDING")
  deliveryMethod  String?
  advancePaid     Boolean      @default(false)
  productImage    String?      // NEW: Store product image URL
  source          String       @default("OUTLET")
  outletName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paymentDeadline DateTime?
  paymentStatus   String       @default("PENDING")
  customizationPrice Float?    @default(0)
  totalPrice      Float?       @default(0)
  auditLogs       AuditLog[]
  stages          OrderStage[]
  createdBy       User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([currentStage])
  @@index([customerPhone])
}

model OrderStage {
  id                 String    @id @default(uuid())
  orderId            String
  stageName          String
  assignedEmployeeId String?
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rejectionReason    String?
  requestNextStep    Boolean   @default(false)
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id])
  order              Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([stageName])
}

model AuditLog {
  id          String   @id @default(uuid())
  orderId     String
  action      String
  details     String?
  performedBy String
  timestamp   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  user        User     @relation(fields: [performedBy], references: [id])

  @@index([orderId])
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String?
  fabric    String?
  stock     Int      @default(0)
  price     Float?
  imageUrl  String?  // NEW: Store inventory item image URL
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
