  @@index([archivedAt])
  @@index([outletName])
  @@index([currentStage])
  @@index([status])
}

model ArchivedAuditLog {
  id          String   @id
  orderId     String?
  action      String
  details     String?
  performedBy String
  timestamp   DateTime
  archivedAt  DateTime @default(now())

  @@index([archivedAt])
  @@index([timestamp])
  @@index([action])
}

model ArchivedChatMessage {
  id              String   @id
  senderId        String
  senderName      String
  senderRole      String
  senderBranch    String?
  message         String?
  voiceUrl        String?
  isPinned        Boolean?
  createdAt       DateTime
  deliveredAt     DateTime?
  readAt          DateTime?
  playedAt        DateTime?
  readReceipts    Json?
  voiceFileDeleted Boolean @default(false)
  archivedAt      DateTime @default(now())

  @@index([archivedAt])
  @@index([createdAt])
  @@index([senderId])
}
