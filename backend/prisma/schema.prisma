generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  role       String       @default("ORDER_ENTRY")
  employeeId String?      @unique
  theme      String?      @default("luxe")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditLogs    AuditLog[]
  stages       OrderStage[]
  createdOrders Order[]   @relation("OrderCreatedBy")
  stockRequests StockRequest[]
  editRequestsRequested OrderEditRequest[] @relation("EditRequestedBy")
  editRequestsReviewed  OrderEditRequest[] @relation("EditReviewedBy")
  deletedOrders         DeletedOrder[] @relation("OrderDeletedBy")
  routingHistoryEntries  RoutingHistory[] @relation("RoutingHistorySentBy")
}

model Order {
  id              String       @id @default(uuid())
  orderNumber     String?      @unique
  shopifyOrderId  String?      @unique
  customerName    String
  customerPhone   String?
  address         String?
  city            String?
  createdById     String?
  type            String       @default("STANDARD")
  urgent          Boolean      @default(false)
  priority        String       @default("NORMAL")
  quantity        Int          @default(1)
  logoDesign      String?
  logoName        String?
  customization   String?
  productDetails  String?
  sizeData        String?
  currentStage    String       @default("ORDER_ENTRY")
  status          String       @default("PENDING")
  deliveryMethod  String?
  advancePaid     Boolean      @default(false)
  advanceAmount   Float        @default(0)
  productImage    String?
  source          String       @default("OUTLET")
  outletName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paymentDeadline DateTime?
  paymentStatus   String       @default("PENDING")
  paymentMethod   String?      @default("CASH")
  customizationPrice Float?    @default(0)
  deliveryCharges  Float?       @default(0)
  totalPrice      Float?       @default(0)
  productionDeadline DateTime?
  trackingNumber  String?
  courierDetails  Json?
  dispatchStatus  String       @default("PENDING")
  deliveryType    String?
  deliveredAt     DateTime?
  returnedAt      DateTime?
  refundStatus    String       @default("NONE")           // NONE, REQUESTED, PROCESSING, REFUNDED, PARTIAL
  refundReason    String?
  refundNote      String?
  refundedAt      DateTime?
  refundedById    String?
  storeRequested  Boolean      @default(false)
  storeRequestedAt DateTime?
  storeAcceptedAt   DateTime?
  instructionNotes String?
  shopifyOrderDate  DateTime?
  orderDestination  String?    // STORE / LOGO_DESIGN / PRODUCTION
  engravingRequired Boolean   @default(false)
  engravingText     String?
  engravingInstructions String?
  // Delivery enhancement fields
  riderAcceptedAt   DateTime?
  noResponseCount   Int          @default(0)
  nextDeliveryDate  DateTime?
  lastDeliveryAttempt DateTime?
  // Revenue / Cost tracking fields
  productCost      Float?     @default(0)
  logoCharges      Float?     @default(0)
  namePrintingCharges Float?  @default(0)
  productionCost   Float?     @default(0)
  grossProfit      Float?     @default(0)
  netProfit        Float?     @default(0)
  auditLogs       AuditLog[]
   stages          OrderStage[]
   editRequests    OrderEditRequest[]
   deliveryAttempts DeliveryAttempt[]
   createdBy       User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([currentStage])
  @@index([customerPhone])
  @@index([storeRequested, storeRequestedAt])
  @@index([priority, createdAt])
  @@index([refundStatus])
  @@index([createdById])
  @@index([dispatchStatus])
  @@index([source])
  @@index([source, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([outletName, createdAt])
  @@index([currentStage, status])
  @@index([type, createdAt])
  @@index([createdAt])
}

model DeliveryAttempt {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  attemptNumber   Int
  status          String    // NO_RESPONSE, DELIVERED, RETURNED, CANCELLED
  riderId         String?
  riderName       String?
  attemptedAt     DateTime  @default(now())
  rescheduledTo   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([orderId, attemptNumber])
  @@index([status])
  @@index([riderId])
}

model RevenueRecord {
  id              String   @id @default(uuid())
  orderId         String?
  orderNumber     String?
  orderType       String   // STANDARD, READY_LOGO, FULL_CUSTOM
  source          String   // ONLINE, OUTLET
  outletName      String?
  orderAmount     Float    @default(0)
  productCost     Float    @default(0)
  logoCharges     Float    @default(0)
  namePrintingCharges Float @default(0)
  customizationCharges Float @default(0)
  productionCost  Float    @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([outletName])
  @@index([orderType])
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([orderId])
}

model OrderStage {
  id                 String    @id @default(uuid())
  orderId            String
  stageName          String
  assignedEmployeeId String?
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rejectionReason    String?
  returnedFrom       String?
  returnReason       String?
  requestNextStep    Boolean   @default(false)
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id])
  order              Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([stageName])
  @@index([status, deadlineAt])
  @@index([assignedEmployeeId])
  @@index([orderId, stageName])
}

model AuditLog {
  id          String    @id @default(uuid())
  orderId     String?
  action      String
  details     String?
  performedBy String
  timestamp   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [performedBy], references: [id])

  @@index([orderId])
  @@index([orderId, action])
  @@index([performedBy])
  @@index([timestamp])
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String?
  size      String?
  fabric    String?
  stock     Int      @default(0)
  price     Float?
  imageUrl  String?
  metadata  String?
  variants  Json?    // Array of {color, size, stock, price}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([name, category])
  @@index([color, size, category])
}

model OutletInventory {
  id         String   @id @default(uuid())
  outletName String
  name       String
  category   String
  color      String?
  size       String?
  fabric     String?
  stock      Int      @default(0)
  price      Float?
  imageUrl   String?
  metadata   String?   // JSON: optionally stores {sourceStoreItemId} for traceability
  variants   Json?     // Array of {color, size, stock, price}
  barcode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([barcode, outletName])
  @@index([outletName])
  @@index([outletName, category])
  @@index([outletName, name])
  @@index([barcode])
}

model StockRequest {
  id           String   @id @default(uuid())
  outletName   String
  itemName     String
  itemCategory String
  quantity     Int
  approvedQty  Int      @default(0)
  status       String   @default("PENDING")
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([outletName])
}

model Allocation {
  id        String   @id @default(uuid())
  cartId    String?
  personName String
  itemName   String
  itemCategory String
  color     String?
  size      String?
  quantity  Int
  notes     String?
  itemId    String?
  allocatedById String?
  allocatedByName String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      AllocationCart? @relation(fields: [cartId], references: [id])

  @@index([personName])
  @@index([createdAt])
  @@index([status])
  @@index([allocatedById])
  @@index([cartId])
}

model AllocationCart {
  id              String      @id @default(uuid())
  displayId       String?
  personName      String
  notes           String?
  totalItems      Int         @default(0)
  totalQuantity   Int         @default(0)
  status          String      @default("PENDING")
  allocatedById   String?
  allocatedByName String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           Allocation[]

  @@index([personName])
  @@index([status])
  @@index([createdAt])
  @@index([allocatedById])
}

model OrderEditRequest {
  id                String    @id @default(uuid())
  orderId           String
  requestedById     String
  requestedChanges  Json      // Proposed new productDetails / items
  reason            String?   // Optional reason for edit
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById      String?
  adminRemarks      String?
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  order             Order     @relation(fields: [orderId], references: [id])
  requestedBy       User      @relation("EditRequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?    @relation("EditReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([status])
}

model DeletedOrder {
  id            String   @id @default(uuid())
  orderNumber   String?
  source        String   // ONLINE, JOHAR TOWN BRANCH, etc.
  customerName  String
  customerPhone String?
  productDetails String? // JSON: minimal product summary
  totalPrice    Float?   @default(0)
  deletedAt     DateTime @default(now())
  deletedById   String
  deletedBy     User     @relation("OrderDeletedBy", fields: [deletedById], references: [id])

  @@index([orderNumber])
  @@index([source])
  @@index([deletedAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionRecord {
  id              String   @id @default(uuid())
  productName     String
  quantity        Int
  rawMaterialCost Float    @default(0)
  productionCost  Float    @default(0)
  totalCost       Float    @default(0)
  sellingValue    Float    @default(0)
  profit          Float    @default(0)
  productionDate  DateTime @default(now())
  source          String   @default("OUTLET")
  orderId         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
}

model ProductionInventory {
  id              String   @id @default(uuid())
  productName     String
  category        String   @default("GENERAL")
  quantity        Int
  productionCost  Float    @default(0)
  sellingValue    Float    @default(0)
  profitMargin    Float    @default(0)
  source          String   @default("OUTLET")
  orderId         String?
  productionDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
  @@index([category])
  @@index([orderId])
}

model SeenTask {
  id        String   @id @default(uuid())
  userId    String
  orderId   String
  stageName String
  seenAt    DateTime @default(now())

  @@unique([userId, orderId, stageName])
  @@index([userId, stageName])
  @@index([orderId])
  @@index([seenAt])
}

model RoutingHistory {
  id              String   @id @default(uuid())
  orderId         String
  sentByUserId    String?
  sentToStage     String
  sentToUserIds   String?  // JSON array of user IDs who received it
  previousStage   String
  newStage        String
  remarks         String?
  createdAt       DateTime @default(now())
  sentByUser      User?    @relation("RoutingHistorySentBy", fields: [sentByUserId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@index([sentToStage])
  @@index([newStage])
  @@index([previousStage, newStage])
}

model OutletDemandRequest {
  id              String    @id @default(uuid())
  transferNumber  String?   @unique
  outletId        String
  outletName      String
  status          String    @default("PENDING")
  items           Json
  notes           String?
  storeNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  approvedById    String?
  acceptedAt      DateTime?
  acceptedById    String?

  @@index([outletId])
  @@index([status])
  @@index([outletName])
  @@index([createdAt])
  @@index([transferNumber])
}

model Client {
  id               String   @id @default(uuid())
  clientNumber     String?  @unique
  name             String
  gender           String
  phone            String
  additionalPhones Json?
  permanentAddress String?
  deliveryAddresses Json?
  city             String?
  measurementChart String?
  sizeDetails      Json?
  standardSizes    Json?
  outletName       String
  createdById      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([outletName])
  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model PosSale {
  id               String   @id @default(uuid())
  receiptNumber    String   @unique
  outletName       String?
  cashierName      String?
  customerName     String?
  customerPhone    String?  @map("customerphone")
  subtotal         Float    @default(0)
  alterationCharges Float   @default(0)
  extraCharges     Float    @default(0)
  discountPercent  Float    @default(0)
  discountAmount   Float    @default(0)
  grandTotal       Float    @default(0)
  advanceAmount    Float    @default(0)
  orderId          String?
  cardChargesPct   Float    @default(0)
  cardChargesAmount Float   @default(0)
  paymentMethod    String   @default("CASH")
  faisalTake       Boolean  @default(false)
  faisalTakenAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            PosSaleItem[]
  returns          PosReturn[]

  @@index([receiptNumber])
  @@index([outletName])
  @@index([createdAt])
}

model PosSaleItem {
  id                String   @id @default(uuid())
  saleId            String
  sale              PosSale  @relation(fields: [saleId], references: [id])
  outletVariantId   String?  // Historical reference ID (plain string, no FK constraint)
  productName       String
  size              String?
  color             String?
  quantity          Int      @default(1)
  unitPrice         Float    @default(0)
  alterationCharges Float    @default(0)
  customization1    Boolean  @default(false)
  customization2    Boolean  @default(false)
  nameEngrave       Boolean  @default(false)
  customizationCharges Float @default(0)
  otherCharges      Float    @default(0)
  discountPct       Float    @default(0)
  discountFixed     Float    @default(0)
  lineTotal         Float    @default(0)

  @@index([saleId])
  @@index([outletVariantId])
}

model PosReturn {
  id              String   @id @default(uuid())
  saleId          String?
  sale            PosSale? @relation(fields: [saleId], references: [id])
  outletVariantId String?  // Historical reference ID (plain string, no FK constraint)
  outletName      String   @default("Johar Town")
  reason              String?
  quantity            Int      @default(1)
  refundAmount        Float    @default(0)
  refundPaymentMethod String   @default("CASH")
  createdAt           DateTime @default(now())

  @@index([saleId])
  @@index([outletVariantId])
  @@index([outletName])
  @@index([createdAt])
}

model OutletTransfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique
  fromOutlet      String
  toOutlet        String
  status          String   @default("PENDING")
  totalItems      Int      @default(0)
  pickupMethod    String?  // RIDER, CUSTOMER
  notes           String?
  requestedById   String?
  requestedByName String?
  approvedById    String?
  approvedAt      DateTime?
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OutletTransferItem[]

  @@index([fromOutlet])
  @@index([toOutlet])
  @@index([status])
}

model OutletTransferItem {
  id              String   @id @default(uuid())
  transferId      String
  transfer        OutletTransfer @relation(fields: [transferId], references: [id])
  outletVariantId String?  // Historical reference ID (plain string, no FK constraint)
  outletInventoryId String?
  productName     String
  color           String?
  size            String?
  barcode         String
  quantity        Int      @default(1)
  unitPrice       Float?

  @@index([transferId])
  @@index([outletVariantId])
  @@index([outletInventoryId])
}
