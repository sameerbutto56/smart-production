generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  role       String       @default("ORDER_ENTRY")
  employeeId String?      @unique
  theme      String?      @default("luxe")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditLogs    AuditLog[]
  stages       OrderStage[]
  createdOrders Order[]   @relation("OrderCreatedBy")
  stockRequests StockRequest[]
  editRequestsRequested OrderEditRequest[] @relation("EditRequestedBy")
  editRequestsReviewed  OrderEditRequest[] @relation("EditReviewedBy")
  deletedOrders         DeletedOrder[] @relation("OrderDeletedBy")
}

model Order {
  id              String       @id @default(uuid())
  orderNumber     String?      @unique
  shopifyOrderId  String?      @unique
  customerName    String
  customerPhone   String?
  address         String?
  city            String?
  createdById     String?
  type            String       @default("STANDARD")
  urgent          Boolean      @default(false)
  priority        String       @default("NORMAL")
  quantity        Int          @default(1)
  logoDesign      String?
  logoName        String?
  customization   String?
  productDetails  String?
  sizeData        String?
  currentStage    String       @default("ORDER_ENTRY")
  status          String       @default("PENDING")
  deliveryMethod  String?
  advancePaid     Boolean      @default(false)
  productImage    String?
  source          String       @default("OUTLET")
  outletName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paymentDeadline DateTime?
  paymentStatus   String       @default("PENDING")
  paymentMethod   String?      @default("CASH")
  customizationPrice Float?    @default(0)
  totalPrice      Float?       @default(0)
  productionDeadline DateTime?
  trackingNumber  String?
  courierDetails  Json?
  dispatchStatus  String       @default("PENDING")
  deliveryType    String?
  // Revenue / Cost tracking fields
  productCost      Float?     @default(0)
  logoCharges      Float?     @default(0)
  namePrintingCharges Float?  @default(0)
  productionCost   Float?     @default(0)
  grossProfit      Float?     @default(0)
  netProfit        Float?     @default(0)
  auditLogs       AuditLog[]
  stages          OrderStage[]
  editRequests    OrderEditRequest[]
  createdBy       User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([currentStage])
  @@index([customerPhone])
}

model RevenueRecord {
  id              String   @id @default(uuid())
  orderId         String?
  orderNumber     String?
  orderType       String   // STANDARD, READY_LOGO, FULL_CUSTOM
  source          String   // ONLINE, OUTLET
  outletName      String?
  orderAmount     Float    @default(0)
  productCost     Float    @default(0)
  logoCharges     Float    @default(0)
  namePrintingCharges Float @default(0)
  customizationCharges Float @default(0)
  productionCost  Float    @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([outletName])
  @@index([orderType])
  @@index([createdAt])
}

model OrderStage {
  id                 String    @id @default(uuid())
  orderId            String
  stageName          String
  assignedEmployeeId String?
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rejectionReason    String?
  requestNextStep    Boolean   @default(false)
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id])
  order              Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([stageName])
}

model AuditLog {
  id          String    @id @default(uuid())
  orderId     String?
  action      String
  details     String?
  performedBy String
  timestamp   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [performedBy], references: [id])

  @@index([orderId])
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String?
  size      String?
  fabric    String?
  stock     Int      @default(0)
  price     Float?
  imageUrl  String?
  metadata  String?
  variants  Json?    // Array of {color, size, stock, price}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockRequest {
  id           String   @id @default(uuid())
  outletName   String
  itemName     String
  itemCategory String
  quantity     Int
  approvedQty  Int      @default(0)
  status       String   @default("PENDING")
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([outletName])
}

model Allocation {
  id        String   @id @default(uuid())
  personName String
  itemName   String
  itemCategory String
  color     String?
  size      String?
  quantity  Int
  notes     String?
  itemId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personName])
  @@index([createdAt])
}

model OrderEditRequest {
  id                String    @id @default(uuid())
  orderId           String
  requestedById     String
  requestedChanges  Json      // Proposed new productDetails / items
  reason            String?   // Optional reason for edit
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById      String?
  adminRemarks      String?
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  order             Order     @relation(fields: [orderId], references: [id])
  requestedBy       User      @relation("EditRequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?    @relation("EditReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([status])
}

model DeletedOrder {
  id            String   @id @default(uuid())
  orderNumber   String?
  source        String   // ONLINE, JOHAR TOWN BRANCH, etc.
  customerName  String
  customerPhone String?
  productDetails String? // JSON: minimal product summary
  totalPrice    Float?   @default(0)
  deletedAt     DateTime @default(now())
  deletedById   String
  deletedBy     User     @relation("OrderDeletedBy", fields: [deletedById], references: [id])

  @@index([orderNumber])
  @@index([source])
  @@index([deletedAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionRecord {
  id              String   @id @default(uuid())
  productName     String
  quantity        Int
  rawMaterialCost Float    @default(0)
  productionCost  Float    @default(0)
  totalCost       Float    @default(0)
  sellingValue    Float    @default(0)
  profit          Float    @default(0)
  productionDate  DateTime @default(now())
  source          String   @default("OUTLET")
  orderId         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
}

model ProductionInventory {
  id              String   @id @default(uuid())
  productName     String
  quantity        Int
  productionCost  Float    @default(0)
  sellingValue    Float    @default(0)
  profitMargin    Float    @default(0)
  source          String   @default("OUTLET")
  productionDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
}
