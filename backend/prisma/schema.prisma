// Return, Replacement & No Response management
model ReturnExchange {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  orderNumber      String?
  customerName     String?
  customerPhone    String?
  type             String   // RETURN, REPLACEMENT, NO_RESPONSE
  status           String   @default("PENDING") // PENDING, ACCEPTED, FAISAL_APPROVED, DISPATCH_READY, COMPLETED, IN_PRODUCTION, RESTOCKED, ROUTED_TO_PRODUCTION, STORE_RECEIVE, REPLACEMENT_COMPLETED, CANCELLED, WAREHOUSE_REJECTED
  routedTo         String   @default("STORE") // STORE, FAISAL — where the case currently sits
  returnReason     String?
  specialNote      String?  // mandatory for REPLACEMENT — goes to Faisal
  orderType        String?  // STANDARD, LOGO, CUSTOM — set by Faisal on replacement create/edit
  originalProducts Json?    // original order items snapshot
  replacementItems Json?    // replacement items (for REPLACEMENT type)
  deliveryAttempts Int      @default(0)
  nextDeliveryDate DateTime?
  warehouseNotes   String?
  dispatchNotes    String?
  handledBy        String?  // inventory view user name
  handledById      String?
  warehouseApprovedBy String?
  warehouseApprovedAt  DateTime?
  dispatchedAt     DateTime?
  faisalApprovedBy String?
  faisalApprovedAt DateTime?
  storeProcessedBy String?
  storeProcessedById String?
  storeProcessedAt DateTime?
  storeAcceptedBy String?
  storeAcceptedById String?
  storeAcceptedAt DateTime?
  inventoryAdjusted Boolean  @default(false)
  productionRouted Boolean   @default(false)
  productionRoutedAt DateTime?
  // Replacement workflow (real replacement Order created by Faisal)
  replacementOrderId String?      // the created replacement Order id
  replacementSummary Json?        // Faisal-generated original vs new summary
  originalRestocked Boolean  @default(false)   // returned goods added back to inventory
  originalRestockedAt DateTime?
  originalRestockedBy String?
  // Per-product acceptance + restock tracking (partial processing)
  acceptedProducts  Json?   // [{idx, name, color, size, quantity, acceptedQty, acceptedBy, acceptedAt}]
  restockedProducts Json?   // [{idx, name, color, size, quantity, restockedQty, restockedBy, restockedAt}]
  replacementCompleted Boolean  @default(false)
  replacementCompletedAt DateTime?
  replacementCompletedBy String?
  // Delivery Boy Return → Inventory View acceptance tracking
  deliveryReturnedBy String?     // delivery boy name who returned
  deliveryReturnedById String?   // delivery boy user id
  deliveryReturnedAt DateTime?   // when delivery boy returned
  acceptedBy        String?      // inventory view user who accepted
  acceptedById      String?      // inventory view user id
  acceptedAt        DateTime?    // when accepted
  // Strict Store-return completion workflow (RESTOCKED → COMPLETED)
  completedBy       String?      // Store user who completed the return
  completedAt       DateTime?    // when the return was completed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type, status])
  @@index([orderId])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([status, createdAt])
}

