generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  role       String       @default("ORDER_ENTRY")
  employeeId String?      @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditLogs    AuditLog[]
  stages       OrderStage[]
  createdOrders Order[]   @relation("OrderCreatedBy")
  stockRequests StockRequest[]
}

model Order {
  id              String       @id @default(uuid())
  orderNumber     String?      @unique
  shopifyOrderId  String?      @unique
  customerName    String
  customerPhone   String?
  address         String?
  city            String?
  createdById     String?
  type            String       @default("STANDARD")
  urgent          Boolean      @default(false)
  priority        String       @default("NORMAL")
  quantity        Int          @default(1)
  logoDesign      String?
  logoName        String?
  customization   String?
  productDetails  String?
  sizeData        String?
  currentStage    String       @default("ORDER_ENTRY")
  status          String       @default("PENDING")
  deliveryMethod  String?
  advancePaid     Boolean      @default(false)
  productImage    String?      // NEW: Store product image URL
  source          String       @default("OUTLET")
  outletName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paymentDeadline DateTime?
  paymentStatus   String       @default("PENDING")
  paymentMethod   String?      @default("CASH")
  customizationPrice Float?    @default(0)
  totalPrice      Float?       @default(0)
  productionDeadline DateTime?
  trackingNumber  String?
  courierDetails  Json?
  dispatchStatus  String       @default("PENDING")
  deliveryType    String?      // PICKUP, IN_CITY, COURIER
  auditLogs       AuditLog[]
  stages          OrderStage[]
  createdBy       User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([currentStage])
  @@index([customerPhone])
}

model OrderStage {
  id                 String    @id @default(uuid())
  orderId            String
  stageName          String
  assignedEmployeeId String?
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rejectionReason    String?
  requestNextStep    Boolean   @default(false)
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id])
  order              Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([stageName])
}

model AuditLog {
  id          String    @id @default(uuid())
  orderId     String?
  action      String
  details     String?
  performedBy String
  timestamp   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [performedBy], references: [id])

  @@index([orderId])
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String?
  size      String?
  fabric    String?
  stock     Int      @default(0)
  price     Float?
  imageUrl  String?
  metadata  String?
  variants  Json?    // Array of {color, size, stock, price}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockRequest {
  id           String   @id @default(uuid())
  outletName   String
  itemName     String
  itemCategory String
  quantity     Int
  approvedQty  Int      @default(0)
  status       String   @default("PENDING")
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([outletName])
}

model Allocation {
  id        String   @id @default(uuid())
  personName String
  itemName   String
  itemCategory String
  color     String?
  size      String?
  quantity  Int
  notes     String?
  itemId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personName])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
