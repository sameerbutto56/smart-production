  size         String?
  barcode      String?
  previousQty  Int
  newQty       Int
  difference   Int
  approvedBy   String?
  createdAt    DateTime @default(now())
  audit        InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([productId])
  @@index([createdAt])
}

