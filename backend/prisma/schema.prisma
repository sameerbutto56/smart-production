generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  role       String       @default("ORDER_ENTRY")
  employeeId String?      @unique
  theme      String?      @default("luxe")
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditLogs    AuditLog[]
  authorizedDevices DeviceAuthorization[]
  stages       OrderStage[]
  createdOrders Order[]   @relation("OrderCreatedBy")
  stockRequests StockRequest[]
  editRequestsRequested OrderEditRequest[] @relation("EditRequestedBy")
  editRequestsReviewed  OrderEditRequest[] @relation("EditReviewedBy")
  deletedOrders         DeletedOrder[] @relation("OrderDeletedBy")
  routingHistoryEntries  RoutingHistory[] @relation("RoutingHistorySentBy")
  alterationsAccepted    Alteration[]     @relation("AlterationAcceptedBy")
  alterationsCompleted   Alteration[]     @relation("AlterationCompletedBy")
  alterationsDone        Alteration[]     @relation("AlterationDoneBy")
  alterationStages       AlterationStage[]
  engravingsAccepted    EngravingRequest[] @relation("EngravingAcceptedBy")
  engravingsCompleted   EngravingRequest[] @relation("EngravingCompletedBy")
  engravingsDone        EngravingRequest[] @relation("EngravingDoneBy")
  engravingStages       EngravingStage[]
  cancellationsRequested OrderCancellationRequest[] @relation("CancellationRequestedBy")
  cancellationsDecided  OrderCancellationRequest[] @relation("CancellationDecidedBy")
  loginSessions          LoginSession[]
  vendorOrdersAsm       VendorOrder[]    @relation("VendorOrderAsm")
}

model Order {
  id              String       @id @default(uuid())
  orderNumber     String?      @unique
  invoiceNumber   String?      @unique
  shopifyOrderId  String?      @unique
  customerName    String
  customerPhone   String?
  address         String?
  city            String?
  createdById     String?
  type            String       @default("STANDARD")
  urgent          Boolean      @default(false)
  priority        String       @default("NORMAL")
  quantity        Int          @default(1)
  logoDesign      String?
  logoName        String?
  customization   String?
  productDetails  Json?
  sizeData        String?
  currentStage    String       @default("ORDER_ENTRY")
  status          String       @default("PENDING")
  deliveryMethod  String?
  advancePaid     Boolean      @default(false)
  advanceAmount   Float        @default(0)
  productImage    String?
  source          String       @default("OUTLET")
  outletName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paymentDeadline DateTime?
  paymentStatus   String       @default("PENDING")
  paymentMethod   String?      @default("CASH")
  customizationPrice Float?    @default(0)
  deliveryCharges  Float?       @default(0)
  totalPrice      Float?       @default(0)
  baseProductAmount Float?     @default(0)
  discountAmount  Float?       @default(0)
  baseProductAmountEditedBy String?
  baseProductAmountEditedAt DateTime?
  productionDeadline DateTime?
  trackingNumber  String?
  courierDetails  Json?
  dispatchStatus  String       @default("PENDING")
  deliveryType    String?
  deliveredAt     DateTime?
  returnedAt      DateTime?
  refundStatus    String       @default("NONE")           // NONE, REQUESTED, PROCESSING, REFUNDED, PARTIAL
  refundReason    String?
  refundNote      String?
  refundedAt      DateTime?
  refundedById    String?
  storeRequested  Boolean      @default(false)
  storeRequestedAt DateTime?
  storeAcceptedAt   DateTime?
  instructionNotes String?
  measurementSpecialNote String?
  shopifyOrderDate  DateTime?
  orderDestination  String?    // STORE / LOGO_DESIGN / PRODUCTION
  engravingRequired Boolean   @default(false)
  engravingText     String?
  engravingType     String?    // 'direct' or 'patch'
  engravingInstructions String?
  logoRequired      Boolean   @default(false)
  engravingNames    String?   // JSON array of names
  engravingLogos    String?   // JSON array of logo descriptions
  // Delivery enhancement fields
  riderAcceptedAt   DateTime?
  noResponseCount   Int          @default(0)
  nextDeliveryDate  DateTime?
  lastDeliveryAttempt DateTime?
  // Revenue / Cost tracking fields
  productCost      Float?     @default(0)
  logoCharges      Float?     @default(0)
  namePrintingCharges Float?  @default(0)
  productionCost   Float?     @default(0)
  grossProfit      Float?     @default(0)
   netProfit        Float?     @default(0)
    customerTakenAt  DateTime?
     orderTakenBy     String?
     placedBy         String?
     placedByEmployeeId String?   // OutletEmployee id who entered the order
    productVerification Json?   // { "0": true, "2": true } — product indices marked as verified in Store
    // Order verification fields
    goForVerification    Boolean   @default(false)
    verifiedAt          DateTime?
    verifiedBy          String?
    verifiedByName      String?
    verifiedAdvanceAmount Float?
    verifiedRemainingBalance Float?
    verificationNote    String?
    verificationReturnedAt DateTime?   // when order was returned to Faisal for corrections
    verificationReturnNote String?     // note from verifier about what changes needed
    auditLogs       AuditLog[]
   stages          OrderStage[]
   editRequests    OrderEditRequest[]
   deliveryAttempts DeliveryAttempt[]
   createdBy       User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([currentStage])
  @@index([customerPhone])
  @@index([storeRequested, storeRequestedAt])
  @@index([priority, createdAt])
  @@index([refundStatus])
  @@index([createdById])
  @@index([dispatchStatus])
  @@index([source, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([outletName, createdAt])
  @@index([currentStage, status])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([goForVerification, verifiedAt])
  dispatchOfficer   String?
    forwardedBy       String?
    // Edit tracking fields
    editedByAdmin   Boolean    @default(false)
    editedAt        DateTime?
  deliveryPayments  DeliveryPayment[]
  noResponseLogs    NoResponseLog[]
  deliveryChargeRecords DeliveryCharge[] @relation("DeliveryChargeToOrder")
  orderAcceptances  OrderAcceptance[]
  returnExchangeCases ReturnExchange[]
  replacementCaseId String?   // link back to the ReturnExchange case when this order is a replacement
  // Cancellation metadata (set only when Admin approves a cancellation request)
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledByName String?
  cancellationReason String?
   cancellationRequests OrderCancellationRequest[] @relation("OrderCancellationRequests")
   postexShipments PostExShipment[]
   // Adjusted financial breakdown (set when user overrides calculated amounts in Financial Summary)
   financialSummary Json?   // { productPrice, logoCharges, namePrinting, customization, cap, delivery, discount, total }
}

model DispatchLog {
  id              String    @id @default(uuid())
  orderId         String
  officerName     String    // Khawar or Faisal
  action          String    // ACCEPTED, DISPATCHED, FORWARDED
  dispatchMethod  String?   // ENAMELS, TCS, POST, CUSTOMER_TAKEAWAY, FORWARD_TO_FAISAL
  orderNumber     String?
  customerName    String?
  city            String?
  createdAt       DateTime  @default(now())

  @@index([officerName])
  @@index([createdAt])
  @@index([orderId])
}

model DeliveryAttempt {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  attemptNumber   Int
  status          String    // NO_RESPONSE, DELIVERED, RETURNED, CANCELLED
  riderId         String?
  riderName       String?
  attemptedAt     DateTime  @default(now())
  rescheduledTo   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId, attemptNumber])
  @@index([status])
  @@index([riderId])
}

model RevenueRecord {
  id              String   @id @default(uuid())
  orderId         String?
  orderNumber     String?
  orderType       String   // STANDARD, READY_LOGO, FULL_CUSTOM
  source          String   // ONLINE, OUTLET
  outletName      String?
  orderAmount     Float    @default(0)
  productCost     Float    @default(0)
  logoCharges     Float    @default(0)
  namePrintingCharges Float @default(0)
  customizationCharges Float @default(0)
  productionCost  Float    @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([outletName])
  @@index([orderType])
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([orderId])
}

model OrderStage {
  id                 String    @id @default(uuid())
  orderId            String
  stageName          String
  assignedEmployeeId String?
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  deadlineAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rejectionReason    String?
  returnedFrom       String?
  returnReason       String?
  requestNextStep    Boolean   @default(false)
  assignedEmployee   User?     @relation(fields: [assignedEmployeeId], references: [id])
  order              Order     @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([stageName])
  @@index([status, deadlineAt])
  @@index([assignedEmployeeId])
  @@index([orderId, stageName])
}

model AuditLog {
  id          String    @id @default(uuid())
  orderId     String?
  action      String
  details     String?
  performedBy String
  timestamp   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [performedBy], references: [id])

  @@index([orderId, action])
  @@index([performedBy])
  @@index([timestamp])
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String?
  size      String?
  fabric    String?
  stock     Int      @default(0)
  price     Float?
  imageUrl  String?
  metadata  String?
  variants  Json?    // Array of {color, size, stock, price}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([name, category])
  @@index([color, size, category])
}

model OutletInventory {
  id         String   @id @default(uuid())
  outletName String
  name       String
  category   String
  color      String?
  size       String?
  fabric     String?
  stock      Int      @default(0)
  price      Float?
  imageUrl   String?
  metadata   String?   // JSON: optionally stores {sourceStoreItemId} for traceability
  variants   Json?     // Array of {color, size, stock, price}
  barcode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([barcode, outletName])
  @@index([outletName, category])
  @@index([outletName, name])
  @@index([barcode])
}

model StockRequest {
  id           String   @id @default(uuid())
  outletName   String
  itemName     String
  itemCategory String
  quantity     Int
  approvedQty  Int      @default(0)
  status       String   @default("PENDING")
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([outletName])
}

model Allocation {
  id        String   @id @default(uuid())
  cartId    String?
  personName String
  itemName   String
  itemCategory String
  color     String?
  size      String?
  quantity  Int
  notes     String?
  itemId    String?
  allocatedById String?
  allocatedByName String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      AllocationCart? @relation(fields: [cartId], references: [id])

  @@index([personName])
  @@index([createdAt])
  @@index([status])
  @@index([allocatedById])
  @@index([cartId])
}

model AllocationCart {
  id              String      @id @default(uuid())
  displayId       String?
  personName      String
  notes           String?
  totalItems      Int         @default(0)
  totalQuantity   Int         @default(0)
  status          String      @default("PENDING")
  allocatedById   String?
  allocatedByName String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           Allocation[]

  @@index([personName])
  @@index([status])
  @@index([createdAt])
  @@index([allocatedById])
}

model OrderEditRequest {
  id                String    @id @default(uuid())
  orderId           String
  requestedById     String
  requestedChanges  Json      // Proposed new productDetails / items
  reason            String?   // Optional reason for edit
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById      String?
  adminRemarks      String?
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  order             Order     @relation(fields: [orderId], references: [id])
  requestedBy       User      @relation("EditRequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?    @relation("EditReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([status])
}

model DeletedOrder {
  id            String   @id @default(uuid())
  orderNumber   String?
  source        String   // ONLINE, JOHAR TOWN BRANCH, etc.
  customerName  String
  customerPhone String?
  productDetails Json? // minimal product summary
  totalPrice    Float?   @default(0)
  deletedAt     DateTime @default(now())
  deletedById   String
  deletedBy     User     @relation("OrderDeletedBy", fields: [deletedById], references: [id])

  @@index([orderNumber])
  @@index([source])
  @@index([deletedAt])
}

model OrderCancellationRequest {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation("OrderCancellationRequests", fields: [orderId], references: [id])
  orderNumber     String?
  reason          String
  status          String    @default("PENDING") // PENDING / APPROVED / REJECTED
  requestedById   String?
  requestedBy     User?     @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  requestedByName String?
  decidedById     String?
  decidedBy       User?     @relation("CancellationDecidedBy", fields: [decidedById], references: [id])
  decidedByName   String?
  decisionNote    String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Device authorization gate for the main username/password login.
// A computer presents a stable client-generated device ID on every login; the
// backend stores a SHA-256 hash of it. Unknown devices are blocked (login does
// not proceed) and a PENDING request is created for Software Settings to
// approve/reject. APPROVED devices pass on every subsequent login with no
// re-verification until disabled/revoked/removed.
model DeviceAuthorization {
  id               String    @id @default(uuid())
  deviceCodeHash   String?
  registrationCode String?   @unique
  deviceName       String?
  assignedRole     String?
  assignedUserId   String?
  status           String    @default("PENDING") // PENDING / APPROVED / REJECTED / DISABLED
  requestNote      String?
  lastLoginAt      DateTime?
  lastIp           String?
  lastUserAgent    String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  assignedUser     User?     @relation(fields: [assignedUserId], references: [id])

  @@index([status])
  @@index([assignedRole])
  @@index([deviceCodeHash])
}

// Profile login / logout tracking. One row is written on every successful login
// (after the device gate passes) and closed when that user logs out. Used by the
// Admin Dashboard "Profile Login Time" card and Software Settings login history.
model LoginSession {
  id         String    @id @default(uuid())
  userId     String
  userEmail  String
  userName   String
  role       String
  deviceId   String?
  deviceName String?
  ip         String?
  userAgent  String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  status     String    @default("ACTIVE") // ACTIVE / LOGGED_OUT
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([role, loginAt])
  @@index([loginAt])
  @@index([status])
}

model ProductionRecord {
  id                    String   @id @default(uuid())
  productName           String
  quantity              Int
  color                 String?
  size                  String?
  variantLabel          String?
  productionStatus      String   @default("COMPLETED")
  productionEmployee    String?
  completedAt           DateTime?
  orderNumber           String?
  rawMaterialCost       Float    @default(0)
  productionCost        Float    @default(0)
  totalCost             Float    @default(0)
  sellingValue          Float    @default(0)
  profit                Float    @default(0)
  productionDate        DateTime @default(now())
  source                String   @default("OUTLET")
  orderId               String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
  @@index([orderNumber])
  @@index([productionStatus])
  @@index([productionEmployee])
}

model ProductionInventory {
  id              String   @id @default(uuid())
  productName     String
  category        String   @default("GENERAL")
  quantity        Int
  productionCost  Float    @default(0)
  sellingValue    Float    @default(0)
  profitMargin    Float    @default(0)
  source          String   @default("OUTLET")
  orderId         String?
  productionDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productionDate])
  @@index([source])
  @@index([category])
  @@index([orderId])
}

model SeenTask {
  id        String   @id @default(uuid())
  userId    String
  orderId   String
  stageName String
  seenAt    DateTime @default(now())

  @@unique([userId, orderId, stageName])
  @@index([userId, stageName])
  @@index([orderId])
  @@index([seenAt])
}

model RoutingHistory {
  id              String   @id @default(uuid())
  orderId         String
  sentByUserId    String?
  sentToStage     String
  sentToUserIds   String?  // JSON array of user IDs who received it
  previousStage   String
  newStage        String
  remarks         String?
  createdAt       DateTime @default(now())
  sentByUser      User?    @relation("RoutingHistorySentBy", fields: [sentByUserId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@index([sentToStage])
  @@index([newStage])
  @@index([previousStage, newStage])
}

model OutletDemandRequest {
  id              String    @id @default(uuid())
  transferNumber  String?   @unique
  outletId        String
  outletName      String
  status          String    @default("PENDING")
  items           Json
  notes           String?
  storeNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  approvedById    String?
  acceptedAt      DateTime?
  acceptedById    String?
  deliveryChannel String?
  deliveryBoyName String?
  dispatchedAt          DateTime?
  dispatchedById        String?
  deliveredAt           DateTime?
  deliveredById         String?
  deliveryBoyAcceptedAt DateTime?
  deliveryBoyAcceptedById String?

  @@index([outletId])
  @@index([status])
  @@index([outletName])
  @@index([createdAt])
}

model PersonalNote {
  id          String   @id @default(uuid())
  ownerName   String
  outletName  String   @default("")
  profileType String   @default("")
  title       String   @default("")
  content     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerName])
  @@index([outletName])
  @@index([profileType])
}

model ChatMessage {
  id           String   @id @default(uuid())
  senderId     String
  senderName   String
  senderRole   String
  senderBranch String  @default("")
  message      String   @default("")
  voiceUrl     String?
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  playedAt     DateTime?

  readReceipts ChatMessageReadReceipt[]

  @@index([createdAt])
  @@index([isPinned])
  @@index([senderId, createdAt])
}

model ChatMessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  userName  String
  userRole  String
  status    String   @default("delivered")
  timestamp DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model Client {
  id               String   @id @default(uuid())
  clientNumber     String?  @unique
  name             String
  gender           String
  phone            String
  additionalPhones Json?
  permanentAddress String?
  deliveryAddresses Json?
  city             String?
  measurementChart String?
  sizeDetails      Json?
  standardSizes    Json?
  outletName       String
  createdById      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([outletName])
  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model PosSale {
  id               String   @id @default(uuid())
  receiptNumber    String   @unique
  clientRequestId  String?  @unique
  outletName       String?
  cashierName      String?
  customerName     String?
  customerPhone    String?  @map("customerphone")
  subtotal         Float    @default(0)
  alterationCharges Float   @default(0)
  extraCharges     Float    @default(0)
  discountPercent  Float    @default(0)
  discountAmount   Float    @default(0)
  grandTotal       Float    @default(0)
  advanceAmount    Float    @default(0)
  deliveryCharges  Float    @default(0)
  orderId          String?
  orderNumber      String?
  cardChargesPct   Float    @default(0)
  cardChargesAmount Float   @default(0)
  paymentMethod    String   @default("CASH")
  cashAmount       Float    @default(0)
  onlineAmount     Float    @default(0)
  faisalTake       Boolean  @default(false)
  faisalTakenAt    DateTime?
   createdAt        DateTime @default(now())
   updatedAt        DateTime @updatedAt
   refundedAt       DateTime?
   additionalNote   String?
   refundReason     String?
    items            PosSaleItem[]
    returns          PosReturn[]
    balancePayments  PosBalancePayment[]

  @@index([outletName, createdAt])
  @@index([orderId])
  @@index([paymentMethod])
  @@index([cashierName])
  @@index([faisalTake])
}

model PosBalancePayment {
  id              String   @id @default(uuid())
  posSaleId       String
  posSale         PosSale  @relation(fields: [posSaleId], references: [id])
  receiptNumber   String   @unique
  originalInvoiceNumber  String
  originalInvoiceTotal   Float
  previouslyPaidAmount   Float
  remainingBalanceBeforePayment Float
  amountPaidNow          Float
  outstandingBalanceAfterPayment Float
  paymentMethod          String   @default("CASH")
  cashAmount             Float    @default(0)
  onlineAmount           Float    @default(0)
  cashierName            String?
  paidAt                 DateTime @default(now())

  @@index([posSaleId])
  @@index([paidAt])
  @@index([paymentMethod])
}

model PaymentMethodChangeLog {
  id             String    @id @default(uuid())
  outletName     String
  saleId         String    // PosSale id (plain string, no FK constraint)
  receiptNumber  String
  orderNumber    String?
  invoiceNumber  String?
  customerName   String?
  grandTotal     Float     @default(0)
  amountMoved    Float     @default(0)
  previousMethod String
  newMethod      String
  changedBy      String
  changedByName  String?
  changedAt      DateTime  @default(now())

  @@index([outletName, changedAt])
  @@index([receiptNumber])
  @@index([changedAt])
}

model PosSaleItem {
  id                String   @id @default(uuid())
  saleId            String
  sale              PosSale  @relation(fields: [saleId], references: [id])
  outletVariantId   String?  // Historical reference ID (plain string, no FK constraint)
  productName       String
  size              String?
  color             String?
  quantity          Int      @default(1)
  unitPrice         Float    @default(0)
  alterationCharges Float    @default(0)
  customization1    Boolean  @default(false)
  customization2    Boolean  @default(false)
  nameEngrave       Boolean  @default(false)
  logoDesign        Boolean  @default(false)
  customizationCharges Float @default(0)
  engravingCharges  Float    @default(0)
  logoCharges       Float    @default(0)
  otherCharges      Float    @default(0)
  discountPct       Float    @default(0)
  discountFixed     Float    @default(0)
