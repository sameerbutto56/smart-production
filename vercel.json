{
  "framework": null,
  "regions": ["bom1"],
  "installCommand": "npm install --prefix frontend && npm install --prefix backend && cd backend && npx prisma generate && npx prisma db push",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
