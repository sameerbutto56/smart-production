{
  "installCommand": "npm install && cd backend && npx prisma db push --skip-generate",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}


